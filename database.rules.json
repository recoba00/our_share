{
  "rules": {
    ".read": false,
    ".write": false,
    "familyMembers": {
      "$familyId": {
        "$userId": {
          ".read": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && root.child('familyMembers').child($familyId).child(auth.uid).exists()",
          ".write": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && ((auth.uid == $userId && ((data.child('role').val() != 'OWNER' && !newData.exists()) || newData.child('role').val() == 'MEMBER' || (!root.child('familyMembers').child($familyId).exists() && newData.child('role').val() == 'OWNER'))) || root.child('familyMembers').child($familyId).child(auth.uid).child('role').val() == 'OWNER')",
          ".validate": "newData.hasChildren(['role', 'userId', 'updatedAt']) && newData.child('userId').val() == $userId && (newData.child('role').val() == 'OWNER' || newData.child('role').val() == 'VICE_OWNER' || newData.child('role').val() == 'PARENT' || newData.child('role').val() == 'MEMBER' || newData.child('role').val() == 'CHILD') && newData.child('updatedAt').isNumber()"
        }
      }
    },
    "liveLocations": {
      "$familyId": {
        ".read": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && root.child('familyMembers').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && ((auth.uid == $userId && root.child('familyMembers').child($familyId).child(auth.uid).exists()) || (root.child('familyMembers').child($familyId).child(auth.uid).child('role').val() == 'OWNER' && !newData.exists()))",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'updatedAt']) && newData.child('latitude').isNumber() && newData.child('latitude').val() >= -90 && newData.child('latitude').val() <= 90 && newData.child('longitude').isNumber() && newData.child('longitude').val() >= -180 && newData.child('longitude').val() <= 180 && (newData.child('accuracy').isNumber() || newData.child('accuracy').val() == null) && newData.child('updatedAt').isNumber()"
        }
      }
    },
    "onlinePresence": {
      "$familyId": {
        ".read": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && root.child('familyMembers').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && ((auth.uid == $userId && root.child('familyMembers').child($familyId).child(auth.uid).exists()) || (root.child('familyMembers').child($familyId).child(auth.uid).child('role').val() == 'OWNER' && !newData.exists()))"
        }
      }
    },
    "deviceStatus": {
      "$familyId": {
        ".read": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && root.child('familyMembers').child($familyId).child(auth.uid).exists()",
        "$userId": {
          ".write": "auth != null && !root.child('restrictedUsers').child(auth.uid).exists() && ((auth.uid == $userId && root.child('familyMembers').child($familyId).child(auth.uid).exists()) || (root.child('familyMembers').child($familyId).child(auth.uid).child('role').val() == 'OWNER' && !newData.exists()))"
        }
      }
    },
    "restrictedUsers": {
      "$userId": {
        ".read": "auth != null && (auth.uid == $userId || auth.uid == 'fOMEpAePtlXUvUukUDClM4lUZC82' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'SUPER_ADMIN' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'MODERATOR')",
        ".write": "auth != null && (auth.uid == 'fOMEpAePtlXUvUukUDClM4lUZC82' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'SUPER_ADMIN' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'MODERATOR') && $userId != 'fOMEpAePtlXUvUukUDClM4lUZC82' && !root.child('platformAdminRoles').child($userId).exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['userId', 'reason', 'createdBy', 'updatedAt'])",
        "userId": { ".validate": "newData.val() == $userId" },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "createdBy": { ".validate": "newData.val() == auth.uid" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "platformAdminRoles": {
      "$userId": {
        ".read": "auth != null && (auth.uid == $userId || auth.uid == 'fOMEpAePtlXUvUukUDClM4lUZC82' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'SUPER_ADMIN')",
        ".write": "auth != null && $userId != auth.uid && $userId != 'fOMEpAePtlXUvUukUDClM4lUZC82' && !root.child('restrictedUsers').child($userId).exists() && (auth.uid == 'fOMEpAePtlXUvUukUDClM4lUZC82' || root.child('platformAdminRoles').child(auth.uid).child('role').val() == 'SUPER_ADMIN')",
        ".validate": "!newData.exists() || newData.hasChildren(['userId', 'role', 'updatedAt'])",
        "userId": { ".validate": "newData.val() == $userId" },
        "role": { ".validate": "newData.val() == 'SUPER_ADMIN' || newData.val() == 'MODERATOR' || newData.val() == 'CONTENT_MANAGER' || newData.val() == 'VIEWER'" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
