rules_version = '2';

service cloud.firestore {
  // ===============================================================
  // Assumed data model
  // ===============================================================
  // users/{uid}: private account profile, email, consent and timestamps.
  // publicProfiles/{uid}: public-safe display name/photo and timestamps.
  // serviceNotices/{noticeId}: title, body, status, author and timestamps.
  // families/{familyId}: crew name, owner, invite code and vice owners.
  // familyInvites/{inviteCode}: crew lookup fields for authenticated joins.
  // familyMembers/{familyId}_{uid}: crew membership, role and display metadata.
  // families/{familyId}/{calendarEvents|memos|polls|pollVotes|chatRooms|messages}:
  // crew-scoped feature documents validated by the domain helpers below.
  // Legacy top-level feature collections remain for compatibility and are
  // guarded by the same membership and ownership checks.
  // ===============================================================
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return signedIn() && request.auth.uid == "fOMEpAePtlXUvUukUDClM4lUZC82";
    }

    function isValidPrivateUser(data, userId) {
      return data.keys().hasOnly([
          "id",
          "displayName",
          "email",
          "photoURL",
          "requiredConsent",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().hasAll([
          "id",
          "displayName",
          "email",
          "photoURL",
          "createdAt",
          "updatedAt"
        ]) &&
        data.id == userId &&
        (data.displayName == null || (data.displayName is string && data.displayName.size() <= 80)) &&
        (data.email == null || (data.email is string && data.email.size() <= 320)) &&
        (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          !("requiredConsent" in data) ||
          (
            data.requiredConsent is map &&
            data.requiredConsent.keys().hasOnly(["privacy", "terms", "version", "consentedAt"]) &&
            data.requiredConsent.keys().hasAll(["privacy", "terms", "version", "consentedAt"]) &&
            data.requiredConsent.privacy == true &&
            data.requiredConsent.terms == true &&
            data.requiredConsent.version is string &&
            data.requiredConsent.version.size() <= 30 &&
            data.requiredConsent.consentedAt is string &&
            data.requiredConsent.consentedAt.size() <= 40
          )
        );
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasOnly([
          "id",
          "displayName",
          "photoURL",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().hasAll([
          "id",
          "displayName",
          "photoURL",
          "createdAt",
          "updatedAt"
        ]) &&
        data.id == userId &&
        (data.displayName == null || (data.displayName is string && data.displayName.size() <= 80)) &&
        (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServiceNotice(data, noticeId) {
      return data.keys().hasOnly([
          "id",
          "title",
          "body",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ]) &&
        data.keys().hasAll([
          "id",
          "title",
          "body",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt",
          "publishedAt"
        ]) &&
        data.id == noticeId &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.body is string &&
        data.body.size() > 0 &&
        data.body.size() <= 2000 &&
        (data.status == "DRAFT" || data.status == "PUBLISHED") &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (
          (data.status == "DRAFT" && data.publishedAt == null) ||
          (data.status == "PUBLISHED" && data.publishedAt is timestamp)
        );
    }

    function membershipId(familyId) {
      return familyId + "_" + request.auth.uid;
    }

    function membershipPath(familyId) {
      return /databases/$(database)/documents/familyMembers/$(membershipId(familyId));
    }

    function memberPath(familyId, userId) {
      return /databases/$(database)/documents/familyMembers/$(familyId + "_" + userId);
    }

    function isFamilyMember(familyId) {
      return signedIn() && exists(membershipPath(familyId));
    }

    function isFamilyOwner(familyId) {
      return signedIn() &&
        (
          get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid ||
          (
            isFamilyMember(familyId) &&
            get(membershipPath(familyId)).data.role == "OWNER"
          )
        );
    }

    function isFamilyViceOwner(familyId) {
      return isFamilyMember(familyId) &&
        get(membershipPath(familyId)).data.role == "VICE_OWNER";
    }

    function isValidFamilyRole(role) {
      return role == "OWNER" ||
        role == "VICE_OWNER" ||
        role == "PARENT" ||
        role == "MEMBER" ||
        role == "CHILD";
    }

    function hasValidViceOwnerIds(data) {
      return data.keys().hasAll(["viceOwnerIds"]) &&
        data.viceOwnerIds is list &&
        data.viceOwnerIds.size() <= 2;
    }

    function isOwnerTransfer(familyId) {
      return request.resource.data.ownerId != resource.data.ownerId &&
        request.resource.data.ownerId != request.auth.uid &&
        getAfter(memberPath(familyId, request.resource.data.ownerId)).data.role == "OWNER" &&
        getAfter(membershipPath(familyId)).data.role == "VICE_OWNER";
    }

    function isValidInviteCode(inviteCode) {
      return inviteCode is string &&
        inviteCode.size() == 6 &&
        exists(/databases/$(database)/documents/familyInvites/$(inviteCode));
    }

    function isCreatingOwnerMembership() {
      return request.resource.data.role == "OWNER" &&
        exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)) &&
        get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid;
    }

    function isCreatingInviteMembership() {
      return request.resource.data.role == "MEMBER" &&
        isValidInviteCode(request.resource.data.inviteCode) &&
        get(/databases/$(database)/documents/familyInvites/$(request.resource.data.inviteCode)).data.familyId == request.resource.data.familyId;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasOnly([
          "id",
          "familyId",
          "title",
          "description",
          "startDate",
          "endDate",
          "allDay",
          "category",
          "repeat",
          "isDayOff",
          "createdBy",
          "visibleTo",
          "visibility",
          "createdAt",
          "updatedAt"
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.description is string &&
        data.description.size() <= 1000 &&
        data.startDate is string &&
        data.endDate is string &&
        data.endDate >= data.startDate &&
        data.allDay is bool &&
        (
          data.category == "FAMILY" ||
          data.category == "PERSONAL" ||
          data.category == "ANNIVERSARY" ||
          data.category == "BIRTHDAY" ||
          data.category == "ETC"
        ) &&
        (
          data.repeat == "NONE" ||
          data.repeat == "YEARLY"
        ) &&
        data.isDayOff is bool &&
        data.visibleTo is list &&
        data.visibleTo.size() <= 50 &&
        (
          data.visibility == "FAMILY" ||
          data.visibility == "PRIVATE"
        ) &&
        (
          data.visibility == "FAMILY" ||
          data.createdBy in data.visibleTo
        );
    }

    function isValidMemo(data) {
      return data.keys().hasOnly([
          "id",
          "familyId",
          "title",
          "content",
          "type",
          "createdBy",
          "visibleTo",
          "visibility",
          "createdAt",
          "updatedAt",
          "encryptedContent",
          "encryptionIv",
          "encryptionSalt"
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        (
          data.type == "PUBLIC" ||
          data.type == "SENSITIVE"
        ) &&
        data.visibleTo is list &&
        data.visibleTo.size() <= 50 &&
        (
          data.visibility == "FAMILY" ||
          data.visibility == "PRIVATE"
        ) &&
        (
          data.visibility == "FAMILY" ||
          data.createdBy in data.visibleTo
        );
    }

    function isValidPoll(data) {
      return data.keys().hasOnly([
          "id",
          "familyId",
          "chatRoomId",
          "title",
          "description",
          "type",
          "options",
          "multipleChoice",
          "anonymous",
          "closesAt",
          "resultVisibility",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.description is string &&
        data.description.size() <= 1000 &&
        (
          data.type == "GENERAL" ||
          data.type == "DATE"
        ) &&
        data.options is list &&
        data.options.size() >= 2 &&
        data.options.size() <= 20 &&
        data.multipleChoice is bool &&
        data.anonymous is bool &&
        (
          data.resultVisibility == "ALWAYS" ||
          data.resultVisibility == "AFTER_VOTE" ||
          data.resultVisibility == "AFTER_CLOSE"
        );
    }

    function isValidChatRoom(data) {
      return data.keys().hasOnly([
          "id",
          "familyId",
          "type",
          "name",
          "memberIds",
          "createdBy",
          "createdAt",
          "updatedAt",
          "lastMessageText",
          "lastMessageAt"
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 80 &&
        (
          data.type == "FAMILY" ||
          data.type == "DIRECT" ||
          data.type == "PRIVATE_GROUP"
        ) &&
        data.memberIds is list &&
        data.memberIds.size() <= 50;
    }

    function isValidMessage(data) {
      return data.keys().hasOnly([
          "id",
          "familyId",
          "roomId",
          "type",
          "text",
          "pollId",
          "createdBy",
          "createdAt",
          "updatedAt",
          "readBy"
        ]) &&
        (
          data.type == "TEXT" ||
          data.type == "POLL"
        ) &&
        data.text is string &&
        data.text.size() > 0 &&
        data.text.size() <= 2000 &&
        data.readBy is list &&
        data.readBy.size() <= 50;
    }

    function canAccessChatRoom(room) {
      return room.keys().hasAll([
          "familyId",
          "type",
          "createdBy",
          "memberIds"
        ]) &&
        room.familyId is string &&
        room.type is string &&
        room.createdBy is string &&
        room.memberIds is list &&
        isFamilyMember(room.familyId) &&
        (
          room.type == "FAMILY" ||
          room.createdBy == request.auth.uid ||
          (room.memberIds is list && request.auth.uid in room.memberIds)
        );
    }

    function canAccessNestedChatRoom(familyId, room) {
      return room.keys().hasAll([
          "familyId",
          "type",
          "createdBy",
          "memberIds"
        ]) &&
        room.familyId == familyId &&
        room.type is string &&
        room.createdBy is string &&
        room.memberIds is list &&
        isFamilyMember(familyId) &&
        (
          room.type == "FAMILY" ||
          room.createdBy == request.auth.uid ||
          request.auth.uid in room.memberIds
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        isValidPrivateUser(request.resource.data, userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidPrivateUser(request.resource.data, userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        isValidPublicProfile(request.resource.data, userId);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidPublicProfile(request.resource.data, userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /serviceNotices/{noticeId} {
      allow read: if signedIn() &&
        (isPlatformAdmin() || resource.data.status == "PUBLISHED");
      allow create: if isPlatformAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.publishedAt == null ||
          request.resource.data.publishedAt == request.time
        ) &&
        isValidServiceNotice(request.resource.data, noticeId);
      allow update: if isPlatformAdmin() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.publishedAt == null ||
          request.resource.data.publishedAt == request.time
        ) &&
        isValidServiceNotice(request.resource.data, noticeId);
      allow delete: if isPlatformAdmin();
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId) || isFamilyOwner(familyId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "id",
          "name",
          "ownerId",
          "inviteCode",
          "viceOwnerIds",
          "createdAt"
        ]) &&
        request.resource.data.id == familyId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.size() == 6 &&
        request.resource.data.ownerId == request.auth.uid &&
        hasValidViceOwnerIds(request.resource.data);
      allow update: if
        (
          isFamilyOwner(familyId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.inviteCode == resource.data.inviteCode &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 50 &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name",
              "updatedAt"
            ]) ||
            (
              request.resource.data.ownerId == resource.data.ownerId &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "viceOwnerIds",
                "updatedAt"
              ]) &&
              hasValidViceOwnerIds(request.resource.data)
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "ownerId",
                "viceOwnerIds",
                "updatedAt"
              ]) &&
              hasValidViceOwnerIds(request.resource.data) &&
              isOwnerTransfer(familyId)
            )
          )
        ) ||
        (
          isFamilyViceOwner(familyId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.inviteCode == resource.data.inviteCode &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "viceOwnerIds",
            "updatedAt"
          ]) &&
          hasValidViceOwnerIds(request.resource.data) &&
          !request.resource.data.viceOwnerIds.hasAny([request.auth.uid])
        );
      allow delete: if isFamilyOwner(familyId);
    }

    match /familyInvites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "familyId",
          "inviteCode",
          "name",
          "ownerId",
          "createdAt"
        ]) &&
        request.resource.data.inviteCode == inviteCode &&
        request.resource.data.inviteCode is string &&
        request.resource.data.inviteCode.size() == 6 &&
        request.resource.data.familyId is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)) &&
        get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        isFamilyOwner(resource.data.familyId) &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.inviteCode == resource.data.inviteCode &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.ownerId == getAfter(
          /databases/$(database)/documents/families/$(resource.data.familyId)
        ).data.ownerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ownerId"]);
      allow delete: if signedIn() && isFamilyOwner(resource.data.familyId);
    }

    match /familyMembers/{memberId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid ||
          isFamilyMember(resource.data.familyId) ||
          isFamilyOwner(resource.data.familyId));
      allow create: if signedIn() &&
        memberId == request.resource.data.familyId + "_" + request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "familyId",
          "userId",
          "role",
          "nickname",
          "relation",
          "permissions",
          "inviteCode",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.familyId is string &&
        isValidFamilyRole(request.resource.data.role) &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() > 0 &&
        request.resource.data.nickname.size() <= 50 &&
        request.resource.data.relation is string &&
        request.resource.data.relation.size() <= 30 &&
        request.resource.data.permissions is list &&
        request.resource.data.permissions.size() <= 20 &&
        (
          isCreatingInviteMembership() ||
          isCreatingOwnerMembership()
        );
      allow update: if signedIn() &&
        (
          (
            isFamilyOwner(resource.data.familyId) &&
            resource.data.role != "OWNER" &&
            request.resource.data.familyId == resource.data.familyId &&
            request.resource.data.userId == resource.data.userId &&
            (
              request.resource.data.role == "PARENT" ||
              request.resource.data.role == "MEMBER" ||
              request.resource.data.role == "CHILD" ||
              request.resource.data.role == "VICE_OWNER"
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "role",
              "updatedAt"
            ]) &&
            getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId == request.auth.uid &&
            hasValidViceOwnerIds(getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data) &&
            (
              (
                request.resource.data.role == "VICE_OWNER" &&
                getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.viceOwnerIds.hasAny([request.resource.data.userId])
              ) ||
              (
                request.resource.data.role != "VICE_OWNER" &&
                !getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.viceOwnerIds.hasAny([request.resource.data.userId])
              )
            )
          ) ||
          (
            isFamilyOwner(resource.data.familyId) &&
            resource.data.userId == request.auth.uid &&
            resource.data.role == "OWNER" &&
            request.resource.data.familyId == resource.data.familyId &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.role == "VICE_OWNER" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "role",
              "updatedAt"
            ]) &&
            getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId != request.auth.uid &&
            hasValidViceOwnerIds(getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data) &&
            getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.viceOwnerIds.hasAny([request.auth.uid])
          ) ||
          (
            isFamilyOwner(resource.data.familyId) &&
            resource.data.role != "OWNER" &&
            request.resource.data.familyId == resource.data.familyId &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.role == "OWNER" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "role",
              "updatedAt"
            ]) &&
            getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId == request.resource.data.userId &&
            getAfter(membershipPath(resource.data.familyId)).data.role == "VICE_OWNER"
          ) ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "nickname",
              "relation",
              "updatedAt"
            ])
          )
        );
      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid ||
          isFamilyOwner(resource.data.familyId));
    }

    match /families/{familyId}/calendarEvents/{eventId} {
      allow read: if resource.data.visibility == "FAMILY" &&
        isFamilyMember(familyId);
      allow read: if resource.data.visibility == "PRIVATE" &&
        request.auth.uid in resource.data.visibleTo &&
        isFamilyMember(familyId);
      allow create: if isFamilyMember(familyId) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.id == eventId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidCalendarEvent(request.resource.data);
      allow update: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidCalendarEvent(request.resource.data);
      allow delete: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /families/{familyId}/memos/{memoId} {
      allow read: if resource.data.visibility == "FAMILY" &&
        isFamilyMember(familyId);
      allow read: if resource.data.visibility == "PRIVATE" &&
        request.auth.uid in resource.data.visibleTo &&
        isFamilyMember(familyId);
      allow create: if isFamilyMember(familyId) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.id == memoId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidMemo(request.resource.data);
      allow update: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidMemo(request.resource.data);
      allow delete: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /families/{familyId}/polls/{pollId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isFamilyMember(familyId) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.id == pollId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidPoll(request.resource.data);
      allow update: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidPoll(request.resource.data);
      allow delete: if isFamilyMember(familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /families/{familyId}/pollVotes/{voteId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/polls/$(resource.data.pollId)) &&
        isFamilyMember(familyId);
      allow create, update: if signedIn() &&
        voteId == request.resource.data.pollId + "_" + request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "pollId",
          "userId",
          "selectedOptions",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.selectedOptions is list &&
        request.resource.data.selectedOptions.size() > 0 &&
        request.resource.data.selectedOptions.size() <= 20 &&
        exists(/databases/$(database)/documents/families/$(familyId)/polls/$(request.resource.data.pollId)) &&
        isFamilyMember(familyId);
      allow delete: if isFamilyMember(familyId) &&
        resource.data.pollId is string &&
        exists(/databases/$(database)/documents/families/$(familyId)/polls/$(resource.data.pollId)) &&
        get(/databases/$(database)/documents/families/$(familyId)/polls/$(resource.data.pollId)).data.createdBy == request.auth.uid;
    }

    match /families/{familyId}/chatRooms/{roomId} {
      allow get: if canAccessNestedChatRoom(familyId, resource.data) ||
        (
          isFamilyMember(familyId) &&
          !exists(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(roomId))
        );
      allow list: if isFamilyMember(familyId) &&
        (
          resource.data.type == "FAMILY" ||
          resource.data.createdBy == request.auth.uid ||
          request.auth.uid in resource.data.memberIds
        );
      allow create: if isFamilyMember(familyId) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.id == roomId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidChatRoom(request.resource.data) &&
        (
          request.resource.data.type == "FAMILY" ||
          request.auth.uid in request.resource.data.memberIds
        );
      allow update: if canAccessNestedChatRoom(familyId, resource.data) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (
          (
            request.resource.data.memberIds == resource.data.memberIds &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "lastMessageText",
              "lastMessageAt",
              "updatedAt"
            ])
          ) ||
          (
            isFamilyOwner(familyId) &&
            resource.data.type == "PRIVATE_GROUP" &&
            request.resource.data.memberIds is list &&
            resource.data.memberIds.hasAll(request.resource.data.memberIds) &&
            request.resource.data.memberIds.hasAny([request.auth.uid]) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "memberIds",
              "updatedAt"
            ])
          )
        );
      allow delete: if canAccessNestedChatRoom(familyId, resource.data) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /families/{familyId}/messages/{messageId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(resource.data.roomId)) &&
        canAccessNestedChatRoom(
          familyId,
          get(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(resource.data.roomId)).data
        );
      allow create: if isFamilyMember(familyId) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.id == messageId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidMessage(request.resource.data) &&
        exists(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(request.resource.data.roomId)) &&
        canAccessNestedChatRoom(
          familyId,
          get(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(request.resource.data.roomId)).data
        );
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(resource.data.roomId)) &&
        canAccessNestedChatRoom(
          familyId,
          get(/databases/$(database)/documents/families/$(familyId)/chatRooms/$(resource.data.roomId)).data
        ) &&
        request.resource.data.familyId == familyId &&
        request.resource.data.roomId == resource.data.roomId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.pollId == resource.data.pollId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.readBy is list &&
        (
          (
            request.resource.data.text == resource.data.text &&
            request.resource.data.readBy.hasAll(resource.data.readBy) &&
            request.auth.uid in request.resource.data.readBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            resource.data.type == "TEXT" &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 2000 &&
            request.resource.data.readBy == resource.data.readBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "text",
              "updatedAt"
            ])
          )
        );
      allow delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    match /calendarEvents/{eventId} {
      allow read: if resource.data.visibility == "FAMILY" &&
        isFamilyMember(resource.data.familyId);
      allow read: if resource.data.visibility == "PRIVATE" &&
        resource.data.visibleTo is list &&
        request.auth.uid in resource.data.visibleTo &&
        isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.id == eventId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidCalendarEvent(request.resource.data);
      allow update: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidCalendarEvent(request.resource.data);
      allow delete: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /memos/{memoId} {
      allow read: if resource.data.visibility == "FAMILY" &&
        isFamilyMember(resource.data.familyId);
      allow read: if resource.data.visibility == "PRIVATE" &&
        resource.data.visibleTo is list &&
        request.auth.uid in resource.data.visibleTo &&
        isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.id == memoId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidMemo(request.resource.data);
      allow update: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidMemo(request.resource.data);
      allow delete: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /polls/{pollId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.id == pollId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidPoll(request.resource.data);
      allow update: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidPoll(request.resource.data);
      allow delete: if isFamilyMember(resource.data.familyId) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /pollVotes/{voteId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/polls/$(resource.data.pollId)) &&
        isFamilyMember(
          get(/databases/$(database)/documents/polls/$(resource.data.pollId)).data.familyId
        );
      allow create, update: if signedIn() &&
        voteId == request.resource.data.pollId + "_" + request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "pollId",
          "userId",
          "selectedOptions",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.selectedOptions is list &&
        request.resource.data.selectedOptions.size() > 0 &&
        request.resource.data.selectedOptions.size() <= 20 &&
        exists(/databases/$(database)/documents/polls/$(request.resource.data.pollId)) &&
        isFamilyMember(
          get(/databases/$(database)/documents/polls/$(request.resource.data.pollId)).data.familyId
        );
      allow delete: if false;
    }

    match /chatRooms/{roomId} {
      allow read: if canAccessChatRoom(resource.data);
      allow create: if isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.id == roomId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidChatRoom(request.resource.data) &&
        (
          request.resource.data.type == "FAMILY" ||
          request.auth.uid in request.resource.data.memberIds
        );
      allow update: if canAccessChatRoom(resource.data) &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.memberIds == resource.data.memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessageText",
          "lastMessageAt",
          "updatedAt"
        ]);
      allow delete: if canAccessChatRoom(resource.data) &&
        resource.data.createdBy == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)) &&
        canAccessChatRoom(get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data);
      allow create: if isFamilyMember(request.resource.data.familyId) &&
        request.resource.data.id == messageId &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidMessage(request.resource.data) &&
        exists(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)) &&
        request.resource.data.familyId == get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data.familyId &&
        canAccessChatRoom(get(/databases/$(database)/documents/chatRooms/$(request.resource.data.roomId)).data);
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)) &&
        canAccessChatRoom(get(/databases/$(database)/documents/chatRooms/$(resource.data.roomId)).data) &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.roomId == resource.data.roomId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.pollId == resource.data.pollId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.readBy is list &&
        (
          (
            request.resource.data.text == resource.data.text &&
            request.resource.data.readBy.hasAll(resource.data.readBy) &&
            request.auth.uid in request.resource.data.readBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            resource.data.type == "TEXT" &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0 &&
            request.resource.data.text.size() <= 2000 &&
            request.resource.data.readBy == resource.data.readBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "text",
              "updatedAt"
            ])
          )
        );
      allow delete: if signedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
